  "info": {
    "_postman_id": "8d4e5cb9-abb8-4d1b-9d5a-4914f9d8970a",
    "name": "Community Health Systems Patient Access API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Community Health Systems provides healthcare interoperability APIs pursuant to the CMS Interoperability and Patient Access Final Rule (CMS-9115-F). The Patient Access API allows third-party applications to retrieve data concerning adjudicated claims, encounters, formulary data, and clinical data using FHIR standards.\n\nContact Support:\n Name: Community Health Systems",
      "type": "text/plain"
    }
  }
